#!/usr/bin/env bash
# =============================================================================
# naat - toolbox CLI
#
# Downloads, runs and executes the scripts (tools) stored in the private
# GitHub repository "banyan". The GitHub token that gives access to banyan is
# never stored in clear text: it lives encrypted (age, passphrase mode) in
# the public "naat" repository, and is decrypted on the fly with the secret
# phrase entered once in `naat configure`.
#
#   naat configure                  enter the secret phrase
#   naat configure list             review the configuration
#   naat configure aws              install the AWS keys kept in banyan
#   naat configure github           install the git/GitHub login kept in banyan
#   naat update-banyan-token TOKEN  encrypt a new banyan token with the phrase
#   naat list                       tools available in banyan
#   naat download NAME              download a tool and open it in an editor
#   naat execute  NAME [ARGS]       temporary download, run, remove
#   naat run      NAME [ARGS]       run a tool that was already downloaded
#
# Exit codes: 0 ok, 1 error, 2 wrong usage. `run` and `execute` return the
# exit code of the script they launched.
# =============================================================================
set -euo pipefail

NAAT_VERSION="0.4.0"

NAAT_HOME="${NAAT_HOME:-$HOME/.naat}"
CONFIG_FILE="$NAAT_HOME/config"
TOKEN_FILE="$NAAT_HOME/banyan-token.age"
TOKEN_REPO_PATH="credentials/banyan-token.age"
AWS_REPO_DIR="credentials/.aws"          # banyan folder: config + credentials        -> ~/.aws/
GITHUB_REPO_DIR="credentials/github"     # banyan folder: .gitconfig + .git-credentials -> ~/
REPOS_CONF="repos.conf"                  # in that folder: folders to turn into git checkouts

# Overridable for tests / GitHub Enterprise.
API_URL="${NAAT_API_URL:-https://api.github.com}"
RAW_URL="${NAAT_RAW_URL:-https://raw.githubusercontent.com}"

CONFIG_KEYS=(owner naat_repo naat_branch tools_repo ref scripts_dir editor phrase)
declare -A CFG=(
    [owner]="lnitaa"        # GitHub account that owns both repositories
    [naat_repo]="naat"      # public repo: this CLI + the encrypted token
    [naat_branch]="main"
    [tools_repo]="banyan"   # private repo: the tools
    [ref]="auto"            # auto | latest | <branch> | <tag>
    [scripts_dir]=""        # empty = $NAAT_HOME/scripts
    [editor]=""             # empty = $VISUAL / $EDITOR / nano / vim / vi
    [phrase]=""
)

TOKEN=""
FILE_PHRASE=""
REF=""
AGE_DIR=""
WORK=""
PROMPT_INTERACTIVE=1
TOKEN_REFRESHED=0
HTTP_CODE=""
OPT_REF=""

# ----------------------------------------------------------------------------
# helpers
# ----------------------------------------------------------------------------
info() { printf '%s\n' "$*" >&2; }
warn() { printf 'naat: warning: %s\n' "$*" >&2; }
die()  { printf 'naat: error: %s\n' "$*" >&2; exit 1; }
usage_error() { printf 'naat: %s\n' "$*" >&2; info "Try 'naat help'."; exit 2; }

cleanup() {
    if [[ -n "$WORK" && -d "$WORK" ]]; then rm -rf "$WORK"; fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

make_work() {
    [[ -n "$WORK" ]] && return 0
    mkdir -p "$NAAT_HOME/tmp"
    chmod 700 "$NAAT_HOME" "$NAAT_HOME/tmp"
    WORK="$(mktemp -d "$NAAT_HOME/tmp/naat.XXXXXXXX")"
}

need_cmd() { command -v "$1" >/dev/null 2>&1 || die "'$1' is required but not installed."; }

scripts_dir() {
    if [[ -n "${CFG[scripts_dir]}" ]]; then printf '%s' "${CFG[scripts_dir]}"
    else printf '%s' "$NAAT_HOME/scripts"; fi
}

# ----------------------------------------------------------------------------
# configuration file (plain key=value, never sourced)
# ----------------------------------------------------------------------------
load_config() {
    if [[ -f "$CONFIG_FILE" ]]; then
        local line key
        while IFS= read -r line || [[ -n "$line" ]]; do
            line="${line%$'\r'}"
            [[ -z "$line" || "$line" == \#* || "$line" != *=* ]] && continue
            key="${line%%=*}"
            if [[ -n "${CFG[$key]+x}" ]]; then CFG[$key]="${line#*=}"; fi
        done < "$CONFIG_FILE"
    fi
    FILE_PHRASE="${CFG[phrase]}"
    # Automation / future UI can inject the phrase without a config file.
    if [[ -n "${NAAT_PHRASE:-}" ]]; then CFG[phrase]="$NAAT_PHRASE"; fi
}

save_config() {
    mkdir -p "$NAAT_HOME"
    chmod 700 "$NAAT_HOME"
    local tmp="$CONFIG_FILE.tmp.$$" k
    (
        umask 077
        {
            echo "# naat configuration - keep this file private (it holds the secret phrase)"
            for k in "${CONFIG_KEYS[@]}"; do printf '%s=%s\n' "$k" "${CFG[$k]}"; done
        } > "$tmp"
    )
    mv -f "$tmp" "$CONFIG_FILE"
    chmod 600 "$CONFIG_FILE"
}

# ----------------------------------------------------------------------------
# encryption (vendored age + age-plugin-batchpass, shipped in the naat repo)
# ----------------------------------------------------------------------------
find_age() {
    [[ -n "$AGE_DIR" ]] && return 0
    local self dir arch d
    self="$(readlink -f "${BASH_SOURCE[0]}")"
    dir="$(dirname "$self")"
    case "$(uname -m)" in
        x86_64|amd64)  arch="amd64" ;;
        aarch64|arm64) arch="arm64" ;;
        *)             arch="unknown" ;;
    esac
    for d in "${NAAT_AGE_DIR:-}" "$dir/../lib/naat" "$dir/../vendor/age/linux-$arch"; do
        if [[ -n "$d" && -x "$d/age" && -x "$d/age-plugin-batchpass" ]]; then
            AGE_DIR="$(cd "$d" && pwd)"
            return 0
        fi
    done
    die "the bundled 'age' binaries were not found. Reinstall naat (install-banyan.sh)."
}

# age_encrypt PHRASE   (plaintext on stdin, ASCII-armored ciphertext on stdout)
age_encrypt() {
    find_age
    PATH="$AGE_DIR:$PATH" AGE_PASSPHRASE="$1" "$AGE_DIR/age" -e -a -j batchpass
}

# age_decrypt PHRASE FILE   (plaintext on stdout)
age_decrypt() {
    find_age
    PATH="$AGE_DIR:$PATH" AGE_PASSPHRASE="$1" "$AGE_DIR/age" -d -j batchpass "$2" 2>/dev/null
}

# ----------------------------------------------------------------------------
# secret prompts
# ----------------------------------------------------------------------------
# prompt_secret "Prompt: "  -> value in $REPLY_SECRET
prompt_secret() {
    REPLY_SECRET=""
    PROMPT_INTERACTIVE=1
    if [[ -t 0 ]]; then
        IFS= read -r -s -p "$1" REPLY_SECRET || true
        echo >&2
    elif [[ -r /dev/tty && -w /dev/tty ]] && { : < /dev/tty; } 2>/dev/null; then
        IFS= read -r -s -p "$1" REPLY_SECRET < /dev/tty || true
        echo >&2
    else
        # not interactive: take one line from stdin (pipes, future UI)
        PROMPT_INTERACTIVE=0
        IFS= read -r REPLY_SECRET || true
    fi
    REPLY_SECRET="${REPLY_SECRET%$'\r'}"
}

check_phrase_strength() {
    if (( ${#1} < 20 )); then
        warn "the phrase is short (${#1} characters). The encrypted token is stored in a"
        warn "PUBLIC repository, so anyone can try to guess the phrase offline."
        warn "Use a long phrase (5+ random words / 20+ characters)."
    fi
}

require_phrase() {
    [[ -n "${CFG[phrase]}" ]] || die "no secret phrase configured. Run: naat configure"
}

# ----------------------------------------------------------------------------
# encrypted token: fetch from the public naat repo, decrypt
# ----------------------------------------------------------------------------
# fetch_token_file DEST  -> 0 downloaded, 1 not published yet, 2 network/other error
fetch_token_file() {
    need_cmd curl
    local url code
    url="$RAW_URL/${CFG[owner]}/${CFG[naat_repo]}/${CFG[naat_branch]}/$TOKEN_REPO_PATH"
    code="$(curl -sS -L -o "$1" -w '%{http_code}' -A "naat/$NAAT_VERSION" "$url" 2>/dev/null)" || return 2
    case "$code" in
        200) grep -q 'BEGIN AGE ENCRYPTED FILE' "$1" || return 2 ;;
        404) return 1 ;;
        *)   return 2 ;;
    esac
}

install_token_file() {   # install_token_file SRC
    mkdir -p "$NAAT_HOME"
    chmod 700 "$NAAT_HOME"
    ( umask 077; cat "$1" > "$TOKEN_FILE.tmp.$$" )
    mv -f "$TOKEN_FILE.tmp.$$" "$TOKEN_FILE"
    chmod 600 "$TOKEN_FILE"
}

sync_token() {
    make_work
    local rc=0
    fetch_token_file "$WORK/token.age" || rc=$?
    case "$rc" in
        0) install_token_file "$WORK/token.age" ;;
        1) return 1 ;;
        *) return 2 ;;
    esac
}

get_token() {
    [[ -n "$TOKEN" ]] && return 0
    require_phrase
    if [[ ! -f "$TOKEN_FILE" ]]; then
        local rc=0
        sync_token || rc=$?
        if (( rc == 1 )); then
            die "no encrypted token published yet in ${CFG[owner]}/${CFG[naat_repo]} ($TOKEN_REPO_PATH). Run: naat update-banyan-token"
        elif (( rc != 0 )); then
            die "could not download the encrypted token from ${CFG[owner]}/${CFG[naat_repo]} (network?)."
        fi
    fi
    TOKEN="$(age_decrypt "${CFG[phrase]}" "$TOKEN_FILE")" \
        || die "the secret phrase does not decrypt the banyan token. Run: naat configure"
    TOKEN="$(printf '%s' "$TOKEN" | tr -d '[:space:]')"
    [[ -n "$TOKEN" ]] || die "the decrypted banyan token is empty. Run: naat update-banyan-token"
}

# ----------------------------------------------------------------------------
# GitHub API
# ----------------------------------------------------------------------------
# gh_request TOKEN ACCEPT URL OUTFILE -> prints the HTTP status code
# The token goes through a curl config on stdin, so it never shows up in `ps`.
gh_request() {
    curl -sS -L -o "$4" -w '%{http_code}' -K - <<EOF
url = "$3"
header = "Authorization: Bearer $1"
header = "Accept: $2"
header = "X-GitHub-Api-Version: 2022-11-28"
user-agent = "naat/$NAAT_VERSION"
EOF
}

# gh_api ACCEPT URL OUTFILE -> HTTP status code in $HTTP_CODE.
# On 401 it refreshes the encrypted token from the naat repo once and retries
# (covers "the token was rotated with update-banyan-token on another machine").
gh_api() {
    local code
    code="$(gh_request "$TOKEN" "$1" "$2" "$3")" || die "could not reach GitHub ($API_URL)."
    if [[ "$code" == "401" && "$TOKEN_REFRESHED" == "0" ]]; then
        TOKEN_REFRESHED=1
        if sync_token; then
            local fresh
            if fresh="$(age_decrypt "${CFG[phrase]}" "$TOKEN_FILE")"; then
                fresh="$(printf '%s' "$fresh" | tr -d '[:space:]')"
                if [[ -n "$fresh" && "$fresh" != "$TOKEN" ]]; then
                    TOKEN="$fresh"
                    code="$(gh_request "$TOKEN" "$1" "$2" "$3")" || die "could not reach GitHub ($API_URL)."
                fi
            fi
        fi
    fi
    HTTP_CODE="$code"
}

api_fail() {   # api_fail CODE WHAT
    case "$1" in
        401) die "GitHub rejected the banyan token (expired or revoked). Create a new one and run: naat update-banyan-token" ;;
        403) die "GitHub denied access while $2 (token permissions or rate limit)." ;;
        404) die "not found while $2. Check that the token can read ${CFG[owner]}/${CFG[tools_repo]}." ;;
        409) die "the repository ${CFG[owner]}/${CFG[tools_repo]} is empty." ;;
        *)   die "GitHub answered HTTP $1 while $2." ;;
    esac
}

json_str() {   # json_str KEY FILE -> first string value of "KEY"
    { tr -d '\n' < "$2" | grep -o "\"$1\": *\"[^\"]*\"" | head -n 1 \
        | sed 's/^[^:]*: *"\(.*\)"$/\1/'; } || true
}

repo_api() { printf '%s/repos/%s/%s' "$API_URL" "${CFG[owner]}" "${CFG[tools_repo]}"; }

resolve_ref() {
    [[ -n "$REF" ]] && return 0
    local want="${OPT_REF:-${CFG[ref]}}" code tag
    case "$want" in
        auto|latest)
            gh_api "application/vnd.github+json" "$(repo_api)/releases/latest" "$WORK/release.json"; code="$HTTP_CODE"
            if [[ "$code" == "200" ]]; then
                tag="$(json_str tag_name "$WORK/release.json")"
                if [[ -n "$tag" ]]; then REF="$tag"; return 0; fi
            elif [[ "$code" != "404" ]]; then
                api_fail "$code" "looking for the latest release"
            fi
            [[ "$want" == "latest" ]] && die "${CFG[owner]}/${CFG[tools_repo]} has no published release (or the token cannot read it)."
            gh_api "application/vnd.github+json" "$(repo_api)" "$WORK/repo.json"; code="$HTTP_CODE"
            [[ "$code" == "200" ]] || api_fail "$code" "reading the repository"
            REF="$(json_str default_branch "$WORK/repo.json")"
            [[ -n "$REF" ]] || REF="main"
            ;;
        *) REF="$want" ;;
    esac
}

# Fills $WORK/tree.txt with the path of every file in the repo at $REF.
load_tree() {
    need_cmd curl
    make_work
    get_token
    resolve_ref
    [[ -f "$WORK/tree.txt" ]] && return 0
    local code
    gh_api "application/vnd.github+json" "$(repo_api)/git/trees/$REF?recursive=1" "$WORK/tree.json"; code="$HTTP_CODE"
    [[ "$code" == "200" ]] || api_fail "$code" "listing the files of '$REF'"
    { tr -d '\n' < "$WORK/tree.json" | tr '{' '\n' | grep '"type": *"blob"' \
        | sed -n 's/.*"path": *"\([^"]*\)".*/\1/p' | LC_ALL=C sort > "$WORK/tree.txt"; } || true
}

urlencode_path() {
    local s="$1"
    s="${s//%/%25}"; s="${s// /%20}"; s="${s//#/%23}"; s="${s//\?/%3F}"; s="${s//+/%2B}"
    printf '%s' "$s"
}

download_file() {   # download_file REPO_PATH DEST
    local code
    mkdir -p "$(dirname "$2")"
    gh_api "application/vnd.github.raw+json" "$(repo_api)/contents/$(urlencode_path "$1")?ref=$REF" "$2"; code="$HTTP_CODE"
    [[ "$code" == "200" ]] || api_fail "$code" "downloading $1"
}

tool_name() { local n="${1%.sh}"; printf '%s' "${n##*/}"; }

# resolve_tool NAME -> sets TOOL_PATH (path of NAME.sh inside banyan)
# NAME may be "s3_restore", "s3_restore.sh" or a path "dir/sub/s3_restore".
resolve_tool() {
    local n="${1%.sh}"
    n="${n#/}"
    [[ -n "$n" ]] || usage_error "missing tool name."
    local -a matches=()
    mapfile -t matches < <(awk -v n="$n.sh" '
        $0 == n { print; next }
        length($0) > length(n) && substr($0, length($0) - length(n)) == "/" n { print }
    ' "$WORK/tree.txt")
    if (( ${#matches[@]} == 0 )); then
        die "no tool named '$n' in ${CFG[owner]}/${CFG[tools_repo]} ($REF). See: naat list"
    elif (( ${#matches[@]} > 1 )); then
        info "naat: '$n' is ambiguous in ${CFG[owner]}/${CFG[tools_repo]} ($REF):"
        printf '  %s\n' "${matches[@]%.sh}" >&2
        die "use the full path, e.g.: naat download ${matches[0]%.sh}"
    fi
    TOOL_PATH="${matches[0]}"
}

# fetch_tool REPO_PATH DEST_DIR
# A tool is the script plus everything that lives in its folder (helper .sql
# files, sub-folders...), because scripts reference siblings via SCRIPT_DIR.
# A script sitting at the root of the repo is downloaded alone.
fetch_tool() {
    local path="$1" dest="$2" dir f rel
    local -a files=()
    dir="$(dirname "$path")"
    if [[ "$dir" == "." ]]; then
        files=("$path")
    else
        mapfile -t files < <(awk -v p="$dir/" 'index($0, p) == 1' "$WORK/tree.txt")
    fi
    mkdir -p "$dest"
    chmod 700 "$dest"
    for f in "${files[@]}"; do
        if [[ "$dir" == "." ]]; then rel="$f"; else rel="${f#"$dir"/}"; fi
        case "/$rel/" in */../*) die "unsafe path in repository: $f" ;; esac
        download_file "$f" "$dest/$rel"
        if [[ "$rel" == *.sh ]]; then
            # scripts edited on Windows may carry CRLF, which breaks bash
            if grep -q $'\r$' "$dest/$rel"; then sed -i 's/\r$//' "$dest/$rel"; fi
            chmod 700 "$dest/$rel"
        else
            chmod 600 "$dest/$rel"
        fi
    done
    info "  ${#files[@]} file(s) from ${CFG[owner]}/${CFG[tools_repo]}@$REF:$dir"
}

pick_editor() {
    local e
    for e in "${CFG[editor]}" "${NAAT_EDITOR:-}" "${VISUAL:-}" "${EDITOR:-}" nano vim vi; do
        [[ -n "$e" ]] || continue
        if command -v "${e%% *}" >/dev/null 2>&1; then printf '%s' "$e"; return 0; fi
    done
    return 1
}

# ----------------------------------------------------------------------------
# commands
# ----------------------------------------------------------------------------
cmd_configure() {
    case "${1:-}" in
        "")   configure_phrase ;;
        list) configure_list ;;
        aws)  shift; cmd_configure_aws "$@" ;;
        github|git) shift; cmd_configure_github "$@" ;;
        set)  shift; configure_set "$@" ;;
        get)  shift; configure_get "$@" ;;
        *)    usage_error "unknown 'configure' sub-command: $1" ;;
    esac
}

configure_phrase() {
    local phrase rc=0
    if [[ -n "${NAAT_PHRASE:-}" ]]; then
        phrase="$NAAT_PHRASE"
    else
        prompt_secret "Enter secret phrase: "
        phrase="$REPLY_SECRET"
    fi
    [[ -n "$phrase" ]] || die "the phrase cannot be empty."

    make_work
    fetch_token_file "$WORK/token.age" || rc=$?
    if (( rc == 0 )); then
        age_decrypt "$phrase" "$WORK/token.age" >/dev/null \
            || die "that phrase does not decrypt the banyan token published in ${CFG[owner]}/${CFG[naat_repo]}. Nothing was saved."
        install_token_file "$WORK/token.age"
        CFG[phrase]="$phrase"; save_config
        info "Phrase verified against the token published in ${CFG[owner]}/${CFG[naat_repo]}."
        if verify_access; then
            # New server: set up the AWS CLI keys and the git/GitHub login too
            # (asks before replacing anything that is already there).
            ( configure_aws auto 0; configure_github auto 0 ) \
                || warn "AWS / GitHub setup did not complete. Retry with: naat configure aws ; naat configure github"
        fi
    elif [[ -f "$TOKEN_FILE" ]]; then
        (( rc == 2 )) && warn "could not reach ${CFG[owner]}/${CFG[naat_repo]}; checking against the local encrypted token."
        age_decrypt "$phrase" "$TOKEN_FILE" >/dev/null \
            || die "that phrase does not decrypt the local encrypted token ($TOKEN_FILE). Nothing was saved."
        CFG[phrase]="$phrase"; save_config
        info "Phrase verified against the local encrypted token."
    else
        (( rc == 2 )) && warn "could not reach ${CFG[owner]}/${CFG[naat_repo]} to verify the phrase."
        if [[ -z "${NAAT_PHRASE:-}" && "$PROMPT_INTERACTIVE" == "1" ]]; then
            prompt_secret "Repeat secret phrase: "
            [[ "$REPLY_SECRET" == "$phrase" ]] || die "the phrases do not match. Nothing was saved."
        fi
        check_phrase_strength "$phrase"
        CFG[phrase]="$phrase"; save_config
        info "Phrase saved. No encrypted banyan token is published yet."
        info "Next step:  naat update-banyan-token"
    fi
    info "Configuration written to $CONFIG_FILE"
}

verify_access() {
    local code
    TOKEN=""; get_token
    gh_api "application/vnd.github+json" "$(repo_api)" "$WORK/repo.json"; code="$HTTP_CODE"
    if [[ "$code" == "200" ]]; then
        info "Access to ${CFG[owner]}/${CFG[tools_repo]} verified."
    else
        warn "the token was decrypted, but GitHub answered HTTP $code for ${CFG[owner]}/${CFG[tools_repo]}."
        return 1
    fi
}

# ask_yes_no "Question"  -> 0 yes, 1 no, 2 nobody to ask (not interactive)
ask_yes_no() {
    local ans=""
    if [[ -t 0 ]]; then
        read -r -p "$1 [y/N] " ans || true
    elif [[ -r /dev/tty && -w /dev/tty ]] && { : < /dev/tty; } 2>/dev/null; then
        read -r -p "$1 [y/N] " ans < /dev/tty || true
    else
        return 2
    fi
    case "$ans" in y|Y|yes|YES|Yes|s|S|si|SI|Si) return 0 ;; *) return 1 ;; esac
}

aws_key_hint() {   # aws_key_hint FILE -> "AKIA...WXYZ" of the first access key, or nothing
    local id
    id="$(sed -n 's/^[[:space:]]*aws_access_key_id[[:space:]]*=[[:space:]]*\([^[:space:]]*\).*/\1/p' "$1" 2>/dev/null | head -n 1)" || true
    if (( ${#id} > 8 )); then printf '%s...%s' "${id:0:4}" "${id: -4}"; fi
}

git_cred_hint() {   # git_cred_hint FILE -> "user@host, user2@host2" (passwords never shown)
    { sed -n 's#^[a-z]*://\([^:@/]*\)[^@]*@\([^/[:space:]]*\).*#\1@\2#p' "$1" 2>/dev/null | head -n 3 | paste -sd, - | sed 's/,/, /g'; } || true
}

cred_hint() {   # cred_hint FILE -> short non-secret description of what the file holds
    case "${1##*/}" in
        credentials*)      aws_key_hint "$1" ;;
        .git-credentials*) git_cred_hint "$1" ;;
    esac
}

# parse_cred_opts ARGS...  -> sets CRED_FORCE (and OPT_REF)
CRED_FORCE=0
parse_cred_opts() {
    local what="$1"; shift
    CRED_FORCE=0
    while (( $# )); do
        case "$1" in
            --force|-f|--yes|-y) CRED_FORCE=1; shift ;;
            --ref)   (( $# >= 2 )) || usage_error "--ref needs a value."; OPT_REF="$2"; shift 2 ;;
            --ref=*) OPT_REF="${1#--ref=}"; shift ;;
            *)       usage_error "usage: naat configure $what [--force] [--ref REF]" ;;
        esac
    done
}

cmd_configure_aws()    { parse_cred_opts aws "$@";    configure_aws manual "$CRED_FORCE"; }
cmd_configure_github() { parse_cred_opts github "$@"; configure_github manual "$CRED_FORCE"; }

# AWS CLI keys:      banyan:credentials/.aws/{config,credentials}            -> ~/.aws/
configure_aws() {
    install_credentials "AWS" aws "$AWS_REPO_DIR" "$HOME/.aws" aws "$1" "$2" config credentials
}

# git / GitHub login: banyan:credentials/github/{.gitconfig,.git-credentials} -> ~/
# Then prepares the folders listed in banyan:credentials/github/repos.conf.
configure_github() {
    local rc=0
    install_credentials "GitHub" github "$GITHUB_REPO_DIR" "$HOME" git "$1" "$2" .git-credentials || rc=$?
    merge_gitconfig "$2" || rc=1
    setup_git_repos "$2" || rc=1
    return "$rc"
}

# merge_gitconfig FORCE
# banyan:credentials/github/.gitconfig -> ~/.gitconfig, setting by setting, so
# what the machine already has (user.name, safe.directory, aliases...) is kept.
# A setting that exists with another value is shown and asked about.
merge_gitconfig() {
    local force="$1" src dst="$HOME/.gitconfig" kv key val cur rc kept=0 added=0
    load_tree
    grep -qxF "$GITHUB_REPO_DIR/.gitconfig" "$WORK/tree.txt" || return 0
    src="$WORK/cred-github/.gitconfig"
    download_file "$GITHUB_REPO_DIR/.gitconfig" "$src"
    if grep -q $'\r$' "$src"; then sed -i 's/\r$//' "$src"; fi

    if [[ ! -e "$dst" ]]; then
        cat "$src" > "$dst"
        chmod 644 "$dst"
        info "GitHub: installed $dst (from ${CFG[owner]}/${CFG[tools_repo]}@$REF)."
        return 0
    fi
    if ! command -v git >/dev/null 2>&1; then
        warn "'git' is not installed; $dst was left as it is."
        return 0
    fi
    while IFS= read -r -u 3 kv; do
        [[ "$kv" == *=* ]] || continue
        key="${kv%%=*}"; val="${kv#*=}"
        if cur="$(git config --global --get "$key" 2>/dev/null)"; then
            [[ "$cur" == "$val" ]] && continue
            info "GitHub: git setting '$key' already exists with a DIFFERENT value."
            info "     current: $cur   ${CFG[tools_repo]}: $val"
            rc=0
            if [[ "$force" != "1" ]]; then
                ask_yes_no "     Change it?" || rc=$?
            fi
            if (( rc == 2 )); then
                warn "'$key' was NOT changed (nobody to ask). To change it: naat configure github --force"
                kept=1; continue
            elif (( rc != 0 )); then
                info "GitHub: kept $key = $cur"
                continue
            fi
        fi
        git config --global "$key" "$val" || { warn "could not set git setting $key."; continue; }
        added=1
        info "GitHub: git setting $key = $val"
    done 3< <(git config -f "$src" --list 2>/dev/null)
    (( added || kept )) || info "GitHub: $dst already has the settings from ${CFG[tools_repo]}."
    (( kept )) && return 1
    return 0
}

trim() {
    local t="$1"
    t="${t#"${t%%[![:space:]]*}"}"
    t="${t%"${t##*[![:space:]]}"}"
    printf '%s' "$t"
}

mask_url() { printf '%s' "$1" | sed 's#://[^@/]*@#://***@#'; }

# setup_git_repos FORCE
# Reads banyan:credentials/github/repos.conf, one folder per line:
#     /absolute/folder | https://github.com/ORG/REPO.git | branch(optional)
# and makes each folder that exists on this machine a working git checkout.
setup_git_repos() {
    local force="$1" conf line path url branch rc=0
    load_tree
    grep -qxF "$GITHUB_REPO_DIR/$REPOS_CONF" "$WORK/tree.txt" || return 0
    conf="$WORK/cred-github/$REPOS_CONF"
    download_file "$GITHUB_REPO_DIR/$REPOS_CONF" "$conf"
    if ! command -v git >/dev/null 2>&1; then
        warn "'git' is not installed; the folders in $REPOS_CONF were not prepared."
        return 1
    fi
    while IFS= read -r -u 3 line || [[ -n "$line" ]]; do
        line="$(trim "${line%$'\r'}")"
        [[ -z "$line" || "$line" == \#* ]] && continue
        IFS='|' read -r path url branch <<< "$line"
        path="$(trim "$path")"; url="$(trim "$url")"; branch="$(trim "${branch:-}")"
        if [[ "$path" != /* || -z "$url" ]]; then
            warn "$REPOS_CONF: line ignored (expected: /folder | url | branch): $line"
            continue
        fi
        setup_one_repo "${path%/}" "$url" "$branch" "$force" || rc=1
    done 3< "$conf"
    return "$rc"
}

# setup_one_repo DIR URL BRANCH FORCE
#   1. marks DIR as git "safe.directory" (fixes "detected dubious ownership")
#   2. git init when DIR is not a repository yet
#   3. adds the remote "origin" (asks before changing a different one)
#   4. for a repository it just created: fetches and attaches the branch to
#      origin WITHOUT touching the files already in the folder
setup_one_repo() {
    local dir="$1" url="$2" branch="$3" force="$4"
    local owner cur scope="--global" fresh=0 empty=0 rc
    if [[ ! -d "$dir" ]]; then
        info "Git: $dir does not exist on this machine; skipped."
        return 0
    fi
    owner="$(stat -c %U "$dir" 2>/dev/null || echo '?')"

    [[ "$(id -u)" == "0" ]] && scope="--system"
    if ! git config "$scope" --get-all safe.directory 2>/dev/null | grep -qxF "$dir"; then
        if git config "$scope" --add safe.directory "$dir"; then
            info "Git: $dir registered as safe.directory ($([[ "$scope" == --system ]] && echo 'all users' || echo "user $(id -un)"))."
        fi
    fi

    if [[ ! -e "$dir/.git" ]]; then
        if [[ ! -w "$dir" ]]; then
            warn "$dir is not a git repository and $(id -un) cannot write in it (owner: $owner). Run: sudo naat configure github"
            return 1
        fi
        [[ -z "$(ls -A "$dir")" ]] && empty=1
        git -C "$dir" init -q || { warn "git init failed in $dir."; return 1; }
        fresh=1
        info "Git: initialized a repository in $dir"
    fi

    cur="$(git -C "$dir" remote get-url origin 2>/dev/null || true)"
    if [[ -z "$cur" ]]; then
        git -C "$dir" remote add origin "$url" || { warn "could not add the remote in $dir (permissions? try with sudo)."; return 1; }
        info "Git: $dir remote 'origin' -> $url"
    elif [[ "$cur" == "$url" ]]; then
        info "Git: $dir remote 'origin' is already $url"
    else
        info "Git: $dir already has a DIFFERENT remote 'origin'."
        info "     current: $(mask_url "$cur")   ${CFG[tools_repo]}: $url"
        rc=0
        if [[ "$force" != "1" ]]; then
            ask_yes_no "     Change it?" || rc=$?
        fi
        if (( rc == 0 )); then
            git -C "$dir" remote set-url origin "$url" || return 1
            info "Git: $dir remote 'origin' -> $url"
        elif (( rc == 2 )); then
            warn "the remote of $dir was NOT changed (nobody to ask). To change it: naat configure github --force"
        else
            info "Git: kept the existing remote of $dir."
        fi
    fi

    if (( fresh )); then
        if git -C "$dir" fetch -q origin; then
            if [[ -z "$branch" ]]; then
                git -C "$dir" remote set-head origin -a >/dev/null 2>&1 || true
                branch="$(git -C "$dir" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null || true)"
                branch="${branch#origin/}"
            fi
            if [[ -n "$branch" ]] && git -C "$dir" rev-parse -q --verify "refs/remotes/origin/$branch" >/dev/null 2>&1; then
                git -C "$dir" update-ref "refs/heads/$branch" "refs/remotes/origin/$branch"
                git -C "$dir" symbolic-ref HEAD "refs/heads/$branch"
                git -C "$dir" config "branch.$branch.remote" origin
                git -C "$dir" config "branch.$branch.merge" "refs/heads/$branch"
                if (( empty )); then
                    git -C "$dir" reset -q --hard
                    info "Git: $dir checked out at origin/$branch."
                else
                    git -C "$dir" reset -q
                    info "Git: $dir attached to origin/$branch. The files already in the folder were NOT"
                    info "     touched; 'git -C $dir status' shows how they differ from the remote."
                fi
            else
                warn "branch '${branch:-?}' was not found in $url; $dir has the remote but no branch yet."
            fi
        else
            warn "'git fetch' failed for $dir (credentials or URL?). The repository and remote are set; retry: git -C $dir fetch origin"
        fi
    fi

    # Created as root inside somebody else's folder: hand the new files over.
    if (( fresh )) && [[ "$(id -u)" == "0" && "$owner" != "root" && "$owner" != "?" ]]; then
        if (( empty )); then chown -R --reference="$dir" "$dir"
        else chown -R --reference="$dir" "$dir/.git"; fi
    fi
    return 0
}

# install_credentials LABEL SUBCMD REPO_DIR DEST_DIR TOOL MODE FORCE FILE...
# Copies the listed files from banyan:REPO_DIR to DEST_DIR.
#   - file missing locally          -> installed, nothing asked
#   - file identical                -> left alone
#   - file exists and is different  -> you are told and asked before replacing
#                                      (a .bak copy is kept); --force = yes
# MODE auto (called from `naat configure`) stays quiet when banyan does not
# have the folder; MODE manual reports it as an error.
install_credentials() {
    local label="$1" subcmd="$2" repo_dir="$3" dest_dir="$4" tool="$5" mode="$6" force="$7"
    shift 7
    local name src dst rc kept=0 changed=0 h_old h_new
    local -a names=()
    load_tree
    for name in "$@"; do
        if grep -qxF "$repo_dir/$name" "$WORK/tree.txt"; then names+=("$name"); fi
    done
    if (( ${#names[@]} == 0 )); then
        [[ "$mode" == "auto" ]] && return 0
        die "nothing to install: $repo_dir/ has none of [$*] in ${CFG[owner]}/${CFG[tools_repo]} ($REF)."
    fi

    for name in "${names[@]}"; do
        src="$WORK/cred-$subcmd/$name"
        dst="$dest_dir/$name"
        download_file "$repo_dir/$name" "$src"
        if grep -q $'\r$' "$src"; then sed -i 's/\r$//' "$src"; fi
        chmod 600 "$src"

        if [[ -e "$dst" ]]; then
            if cmp -s "$src" "$dst"; then
                info "$label: $dst is already up to date."
                continue
            fi
            info "$label: $dst already exists and is DIFFERENT from the one in ${CFG[tools_repo]}."
            h_old="$(cred_hint "$dst")"; h_new="$(cred_hint "$src")"
            if [[ -n "$h_old$h_new" ]]; then
                info "     current: ${h_old:-?}   ${CFG[tools_repo]}: ${h_new:-?}"
            fi
            if [[ "$force" != "1" ]]; then
                rc=0
                ask_yes_no "     Replace it? (the current file is kept as a .bak copy)" || rc=$?
                if (( rc == 2 )); then
                    warn "$dst was NOT replaced (nobody to ask). To replace it: naat configure $subcmd --force"
                    kept=1; continue
                elif (( rc != 0 )); then
                    info "$label: kept your existing $dst."
                    continue
                fi
            fi
            cp -p "$dst" "$dst.bak-$(date +%Y%m%d-%H%M%S)"
        fi
        if [[ ! -d "$dest_dir" ]]; then mkdir -p "$dest_dir"; chmod 700 "$dest_dir"; fi
        ( umask 077; cat "$src" > "$dst.tmp.$$" )
        mv -f "$dst.tmp.$$" "$dst"
        chmod 600 "$dst"
        changed=1
        info "$label: installed $dst (from ${CFG[owner]}/${CFG[tools_repo]}@$REF)."
    done

    if (( changed )) && ! command -v "$tool" >/dev/null 2>&1; then
        warn "the $label files are in place, but the '$tool' command is not installed on this machine."
    fi
    if (( kept )) && [[ "$mode" == "manual" ]]; then return 1; fi
    return 0
}

configure_list() {
    local k v
    printf '%-14s %s\n' "config file" "$CONFIG_FILE$([[ -f "$CONFIG_FILE" ]] || echo '  (not created yet)')"
    for k in "${CONFIG_KEYS[@]}"; do
        v="${CFG[$k]}"
        case "$k" in
            phrase)      if [[ -n "$v" ]]; then v="******** (set, ${#v} characters)"; else v="(not set - run: naat configure)"; fi ;;
            scripts_dir) [[ -n "$v" ]] || v="$(scripts_dir)  (default)" ;;
            editor)      [[ -n "$v" ]] || v="$(pick_editor || echo none)  (auto)" ;;
        esac
        printf '%-14s %s\n' "$k" "$v"
    done
    if [[ -f "$TOKEN_FILE" ]]; then
        printf '%-14s %s\n' "banyan token" "encrypted at $TOKEN_FILE (updated $(date -r "$TOKEN_FILE" '+%Y-%m-%d %H:%M'))"
    else
        printf '%-14s %s\n' "banyan token" "(no local copy yet)"
    fi
    local awsf
    for awsf in credentials config; do
        if [[ -f "$HOME/.aws/$awsf" ]]; then
            printf '%-14s %s\n' "$([[ "$awsf" == credentials ]] && echo "aws keys" || echo "aws config")" "$HOME/.aws/$awsf$([[ "$awsf" == credentials ]] && printf '  (key %s)' "$(aws_key_hint "$HOME/.aws/$awsf")")"
        else
            printf '%-14s %s\n' "$([[ "$awsf" == credentials ]] && echo "aws keys" || echo "aws config")" "(not present - run: naat configure aws)"
        fi
    done
    for awsf in .git-credentials .gitconfig; do
        if [[ -f "$HOME/$awsf" ]]; then
            printf '%-14s %s\n' "$([[ "$awsf" == .git-credentials ]] && echo "git login" || echo "git config")" "$HOME/$awsf$([[ "$awsf" == .git-credentials ]] && printf '  (%s)' "$(git_cred_hint "$HOME/$awsf")")"
        else
            printf '%-14s %s\n' "$([[ "$awsf" == .git-credentials ]] && echo "git login" || echo "git config")" "(not present - run: naat configure github)"
        fi
    done
    printf '%-14s %s\n' "token source" "$RAW_URL/${CFG[owner]}/${CFG[naat_repo]}/${CFG[naat_branch]}/$TOKEN_REPO_PATH"
    if ( find_age ) 2>/dev/null; then
        find_age
        printf '%-14s %s\n' "encryption" "age $("$AGE_DIR/age" --version 2>/dev/null) ($AGE_DIR)"
    else
        printf '%-14s %s\n' "encryption" "bundled age NOT FOUND"
    fi
    printf '%-14s %s\n' "naat version" "$NAAT_VERSION"
}

configure_set() {
    (( $# == 2 )) || usage_error "usage: naat configure set KEY VALUE"
    local key="$1" val="$2"
    [[ "$key" != "phrase" ]] || usage_error "use 'naat configure' to change the phrase."
    [[ -n "${CFG[$key]+x}" ]] || usage_error "unknown key '$key'. Keys: ${CONFIG_KEYS[*]/phrase/}"
    [[ "$val" != *$'\n'* ]] || die "the value cannot contain a newline."
    CFG[$key]="$val"
    # keep whatever phrase is in the file, not one injected via NAAT_PHRASE
    CFG[phrase]="$FILE_PHRASE"
    save_config
    info "$key=$val"
}

configure_get() {
    (( $# == 1 )) || usage_error "usage: naat configure get KEY"
    [[ "$1" != "phrase" ]] || usage_error "the phrase is not displayed."
    [[ -n "${CFG[$1]+x}" ]] || usage_error "unknown key '$1'."
    printf '%s\n' "${CFG[$1]}"
}

cmd_update_token() {
    local new="" repo_dir="" verify=1
    while (( $# )); do
        case "$1" in
            --repo)      (( $# >= 2 )) || usage_error "--repo needs a directory."; repo_dir="$2"; shift 2 ;;
            --no-verify) verify=0; shift ;;
            -h|--help)   usage; exit 0 ;;
            -*)          usage_error "unknown option: $1" ;;
            *)           [[ -z "$new" ]] || usage_error "only one token expected."; new="$1"; shift ;;
        esac
    done

    if [[ -z "${CFG[phrase]}" ]]; then
        info "No secret phrase configured yet; choose one now."
        prompt_secret "Enter secret phrase: ";  local p1="$REPLY_SECRET"
        [[ -n "$p1" ]] || die "the phrase cannot be empty."
        if [[ "$PROMPT_INTERACTIVE" == "1" ]]; then
            prompt_secret "Repeat secret phrase: "
            [[ "$REPLY_SECRET" == "$p1" ]] || die "the phrases do not match."
        fi
        CFG[phrase]="$p1"; save_config
    fi
    check_phrase_strength "${CFG[phrase]}"

    if [[ -z "$new" ]]; then
        prompt_secret "Enter new banyan token: "
        new="$REPLY_SECRET"
    fi
    new="$(printf '%s' "$new" | tr -d '[:space:]')"
    [[ -n "$new" ]] || die "the token cannot be empty."

    make_work
    if (( verify )); then
        need_cmd curl
        local code
        code="$(gh_request "$new" "application/vnd.github+json" "$(repo_api)" "$WORK/repo.json")" \
            || die "could not reach GitHub to verify the token (use --no-verify to skip)."
        [[ "$code" == "200" ]] \
            || die "GitHub answered HTTP $code: this token cannot read ${CFG[owner]}/${CFG[tools_repo]}. Nothing was changed. (--no-verify to skip the check)"
        info "Token verified: it can read ${CFG[owner]}/${CFG[tools_repo]}."
    fi

    printf '%s\n' "$new" | age_encrypt "${CFG[phrase]}" > "$WORK/new-token.age" \
        || die "encryption failed."
    [[ "$(age_decrypt "${CFG[phrase]}" "$WORK/new-token.age")" == "$new" ]] \
        || die "encryption self-check failed. Nothing was changed."
    install_token_file "$WORK/new-token.age"
    TOKEN=""
    info "Encrypted token saved to $TOKEN_FILE"

    # Publish: drop the file in a checkout of the naat repo, if we have one.
    if [[ -z "$repo_dir" ]] && command -v git >/dev/null 2>&1; then
        local top
        top="$(git rev-parse --show-toplevel 2>/dev/null || true)"
        if [[ -n "$top" && -f "$top/install-banyan.sh" && -f "$top/bin/naat" ]]; then repo_dir="$top"; fi
    fi
    if [[ -n "$repo_dir" ]]; then
        [[ -d "$repo_dir" ]] || die "--repo: '$repo_dir' is not a directory."
        mkdir -p "$repo_dir/credentials"
        cat "$TOKEN_FILE" > "$repo_dir/$TOKEN_REPO_PATH"
        info ""
        info "Updated $repo_dir/$TOKEN_REPO_PATH. Publish it so every server gets it:"
        info "  cd $repo_dir && git add $TOKEN_REPO_PATH && git commit -m 'Rotate banyan token' && git push"
    else
        info ""
        info "To make it available to every server, commit the text below as"
        info "'$TOKEN_REPO_PATH' in the ${CFG[owner]}/${CFG[naat_repo]} repository"
        info "(or run this command inside a clone of it, or with --repo DIR):"
        info ""
        cat "$TOKEN_FILE"
    fi
}

cmd_sync_token() {
    require_phrase
    local rc=0
    sync_token || rc=$?
    (( rc != 1 )) || die "no encrypted token published in ${CFG[owner]}/${CFG[naat_repo]} ($TOKEN_REPO_PATH)."
    (( rc == 0 )) || die "could not download the encrypted token (network?)."
    age_decrypt "${CFG[phrase]}" "$TOKEN_FILE" >/dev/null \
        || die "downloaded, but the configured phrase does not decrypt it. Run: naat configure"
    info "Encrypted token refreshed from ${CFG[owner]}/${CFG[naat_repo]}."
}

cmd_list() {
    if [[ "${1:-}" == "local" || "${1:-}" == "--local" ]]; then
        local d found=0 sd
        sd="$(scripts_dir)"
        if [[ -d "$sd" ]]; then
            for d in "$sd"/*/; do
                [[ -d "$d" ]] || continue
                d="${d%/}"
                [[ -f "$d/${d##*/}.sh" ]] || continue
                printf '%-24s %s\n' "${d##*/}" "$d/${d##*/}.sh"; found=1
            done
        fi
        (( found )) || info "No downloaded tools in $sd"
        return 0
    fi
    parse_ref_opts "$@"
    load_tree
    local p shown=0
    while IFS= read -r p; do
        [[ "$p" == *.sh ]] || continue
        printf '%-24s %s\n' "$(tool_name "$p")" "$p"; shown=1
    done < "$WORK/tree.txt"
    (( shown )) || info "No .sh tools found in ${CFG[owner]}/${CFG[tools_repo]} ($REF)."
    info "(${CFG[owner]}/${CFG[tools_repo]} @ $REF)"
}

ARGS=()
parse_ref_opts() {   # extracts --ref R; the rest lands in ARGS
    ARGS=()
    while (( $# )); do
        case "$1" in
            --ref)   (( $# >= 2 )) || usage_error "--ref needs a value."; OPT_REF="$2"; shift 2 ;;
            --ref=*) OPT_REF="${1#--ref=}"; shift ;;
            *)       ARGS+=("$1"); shift ;;
        esac
    done
}

cmd_download() {
    local name="" edit=1 force=0
    while (( $# )); do
        case "$1" in
            --no-edit)  edit=0; shift ;;
            --force|-f) force=1; shift ;;
            --ref)      (( $# >= 2 )) || usage_error "--ref needs a value."; OPT_REF="$2"; shift 2 ;;
            --ref=*)    OPT_REF="${1#--ref=}"; shift ;;
            -*)         usage_error "unknown option: $1" ;;
            *)          [[ -z "$name" ]] || usage_error "only one tool name expected."; name="$1"; shift ;;
        esac
    done
    [[ -n "$name" ]] || usage_error "usage: naat download NAME [--no-edit] [--force] [--ref REF]"

    local base dest sd script
    base="$(tool_name "$name")"
    sd="$(scripts_dir)"
    dest="$sd/$base"
    if [[ -e "$dest" && "$force" == "0" ]]; then
        die "'$base' is already downloaded in $dest (your local edits live there).
       Use 'naat run $base' to run it, or 'naat download $base --force' to fetch it
       again (the current copy is kept as a .bak folder)."
    fi

    load_tree
    resolve_tool "$name"
    info "Downloading $base ..."
    fetch_tool "$TOOL_PATH" "$WORK/tool"
    mkdir -p "$sd"
    chmod 700 "$sd"
    if [[ -e "$dest" ]]; then
        local bak
        bak="$dest.bak-$(date +%Y%m%d-%H%M%S)"
        mv "$dest" "$bak"
        info "Previous copy kept in $bak"
    fi
    mv "$WORK/tool" "$dest"
    script="$dest/$base.sh"
    info "Saved: $script"

    if (( edit )) && [[ -t 0 && -t 1 ]]; then
        local ed
        if ed="$(pick_editor)"; then
            # shellcheck disable=SC2086  # the editor setting may carry arguments
            $ed "$script" || warn "the editor exited with an error."
        else
            warn "no editor found (set one with: naat configure set editor nano)."
        fi
    fi
    info "Run it with: naat run $base"
}

cmd_execute() {
    while (( $# )); do
        case "$1" in
            --ref)   (( $# >= 2 )) || usage_error "--ref needs a value."; OPT_REF="$2"; shift 2 ;;
            --ref=*) OPT_REF="${1#--ref=}"; shift ;;
            --)      shift; break ;;
            -*)      usage_error "unknown option: $1 (options go before NAME; script arguments after it)" ;;
            *)       break ;;
        esac
    done
    (( $# >= 1 )) || usage_error "usage: naat execute [--ref REF] NAME [ARGS...]"
    local name="$1" base script rc=0
    shift
    base="$(tool_name "$name")"

    load_tree
    resolve_tool "$name"
    info "Fetching $base (temporary copy) ..."
    fetch_tool "$TOOL_PATH" "$WORK/exec"
    script="$WORK/exec/$base.sh"
    info "Executing $base ..."
    "$script" "$@" || rc=$?
    cleanup
    info "Temporary copy of $base removed."
    exit "$rc"
}

cmd_run() {
    (( $# >= 1 )) || usage_error "usage: naat run NAME [ARGS...]"
    local base script
    base="$(tool_name "$1")"
    shift
    script="$(scripts_dir)/$base/$base.sh"
    [[ -f "$script" ]] || die "'$base' is not downloaded yet. Run: naat download $base   (or: naat execute $base)"
    chmod u+x "$script"
    exec "$script" "$@"
}

usage() {
    cat <<EOF
naat $NAAT_VERSION - toolbox CLI for the tools stored in ${CFG[owner]}/${CFG[tools_repo]}

Usage: naat <command> [arguments]

Setup
  configure                     Enter the secret phrase (decrypts the banyan token)
  configure list                Review the configuration
  configure aws [--force]       Install the AWS CLI keys kept in banyan
                                ($AWS_REPO_DIR) into ~/.aws. Done automatically by
                                'configure' on a new server; when ~/.aws already
                                has different files you are asked before replacing
  configure github [--force]    Same for the git/GitHub login kept in banyan
                                ($GITHUB_REPO_DIR): ~/.gitconfig, ~/.git-credentials.
                                Also prepares the folders listed in its repos.conf:
                                safe.directory, git init, remote origin
  configure set KEY VALUE       Change a setting (owner, naat_repo, naat_branch,
                                tools_repo, ref, scripts_dir, editor)
  configure get KEY             Print one setting
  update-banyan-token [TOKEN]   Encrypt a new banyan token with the phrase
                                (asks for it when omitted; --repo DIR writes it
                                into a clone of the naat repo; --no-verify)
  sync-token                    Re-download the encrypted token from the naat repo

Tools
  list [--ref REF]              Tools available in banyan
  list local                    Tools already downloaded
  download NAME [--no-edit] [--force] [--ref REF]
                                Download a tool and open it in an editor
  execute [--ref REF] NAME [ARGS...]
                                Temporary download, run, then remove
  run NAME [ARGS...]            Run a tool that was already downloaded

Other
  version                       Print the version
  help                          This help

ref: 'auto' (default) uses the latest GitHub Release of banyan, or the default
branch when there is no release yet; 'latest' requires a release; anything
else is a branch or tag name.

Files: $NAAT_HOME/config, $NAAT_HOME/banyan-token.age, $(scripts_dir)/
Environment: NAAT_HOME, NAAT_PHRASE (non-interactive use), NAAT_EDITOR
EOF
}

main() {
    load_config
    local cmd="${1:-help}"
    (( $# )) && shift
    case "$cmd" in
        configure)                         cmd_configure "$@" ;;
        update-banyan-token|update-token)  cmd_update_token "$@" ;;
        sync-token)                        cmd_sync_token "$@" ;;
        list|ls)                           cmd_list "$@" ;;
        download)                          cmd_download "$@" ;;
        execute|exec)                      cmd_execute "$@" ;;
        run)                               cmd_run "$@" ;;
        version|--version|-V)              echo "naat $NAAT_VERSION" ;;
        help|--help|-h)                    usage ;;
        *)                                 usage_error "unknown command: $cmd" ;;
    esac
}

main "$@"
